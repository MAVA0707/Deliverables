{
  "name": "arXiv to Notion Summarizer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arxiv-summarizer",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "4982d109-4479-43f6-a0d0-c2b725e8412c",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "arxiv-summarizer"
    },
    {
      "parameters": {
        "jsCode": "const url = $input.item.json.body.arxiv_url;\n\nif (!url) {\n  throw new Error('Missing arxiv_url in request body');\n}\n\nconst match = url.match(/abs\\/([\\d.v]+)/);\n\nif (!match) {\n  throw new Error('Could not extract arXiv ID from URL: ' + url);\n}\n\nreturn {\n  paper_id: match[1],\n  arxiv_url: url\n};"
      },
      "id": "e1327074-80d1-4c09-a0e2-f879c02a9951",
      "name": "Extract Paper ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://export.arxiv.org/api/query",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id_list",
              "value": "={{ $json.paper_id }}"
            },
            {
              "name": "start",
              "value": "0"
            },
            {
              "name": "max_results",
              "value": "1"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "306e175b-6256-42d9-bc3e-17971d3b011c",
      "name": "Fetch from arXiv API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.item.json.data;\n\nconst getTag = (tag) => {\n  const re = new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`, 'i');\n  const m = xml.match(re);\n  return m ? m[1].trim() : '';\n};\n\nconst getAllTags = (tag) => {\n  const re = new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`, 'gi');\n  const matches = [];\n  let m;\n  while ((m = re.exec(xml)) !== null) matches.push(m[1].trim());\n  return matches;\n};\n\nconst authorMatches = getAllTags('name');\nconst category = xml.match(/<arxiv:primary_category[^>]+term=\"([^\"]+)\"/)?.[1] || '';\n\nconst entry = xml.match(/<entry>([\\s\\S]*?)<\\/entry>/i)?.[1] || '';\nconst title = entry.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i)?.[1]\n  ?.replace(/\\n/g, ' ').trim() || '';\nconst abstract = getTag('summary').replace(/\\n/g, ' ').trim();\n\nif (!title || !abstract) {\n  throw new Error('Could not parse arXiv XML — check paper ID is valid');\n}\n\nreturn {\n  paper_id: $('Extract Paper ID').item.json.paper_id,\n  arxiv_url: $('Extract Paper ID').item.json.arxiv_url,\n  title: title,\n  authors: authorMatches.join(', '),\n  abstract: abstract,\n  category: category\n};"
      },
