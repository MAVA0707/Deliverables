    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validate email format\nconst email = $json.text.trim();\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isValid = emailRegex.test(email);\n\nreturn {\n  chatId: $json.chatId,\n  userId: $json.userId,\n  email,\n  isValidEmail: isValid,\n  answers: $json.answers,\n  name: $json.name\n};\n"
      },
      "id": "node_validate_email",
      "name": "Validate Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 900]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_email_valid",
              "leftValue": "={{ $json.isValidEmail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
