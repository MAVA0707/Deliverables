    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract classification result and prepare routing\nconst classification = ($json.message?.content || '').trim().toUpperCase();\nconst validClasses = ['WATCH', 'RING', 'CHESTBAND'];\nconst product = validClasses.includes(classification) ? classification : 'WATCH'; // default fallback\n\nreturn {\n  chatId: $json.chatId || $('Save Email').item.json.chatId,\n  userId: $json.userId || $('Save Email').item.json.userId,\n  name: $('Save Email').item.json.name,\n  email: $('Save Email').item.json.email,\n  answers: $('Save Email').item.json.answers,\n  product,\n  timestamp: new Date().toISOString(),\n  source: 'Telegram - Social Campaign'\n};\n"
      },
