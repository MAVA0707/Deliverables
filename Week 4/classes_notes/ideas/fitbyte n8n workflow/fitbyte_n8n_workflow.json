    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a fitness product classification expert for FitByte. Based on a user's answers to 3 qualification questions, you must classify them into exactly one product category.\n\nProduct Definitions:\n- WATCH: Smartwatch users who want wrist-based tracking. Typical profile: weight loss or performance goals, prefers wrist wearables, trains regularly or seriously.\n- RING: Minimal tracker users who want discreet monitoring. Typical profile: general wellness or weight loss, prefers discreet/ring form factor, casual to regular training.\n- CHESTBAND: Professional athletes who want maximum precision. Typical profile: performance tracking or muscle building, prefers chest strap accuracy, trains at athlete level (5+/week or competitive).\n\nIMPORTANT: You MUST respond with ONLY one of these three words: WATCH, RING, or CHESTBAND. No explanation, no punctuation, just the single word."
            },
            {
              "role": "user",
              "content": "=Classify this lead based on their answers:\n\nQ1 - Main fitness goal: {{ $json.answers[0].answer }}\nQ2 - Tracking preference: {{ $json.answers[1].answer }}\nQ3 - Training intensity: {{ $json.answers[2].answer }}\n\nClassify as WATCH, RING, or CHESTBAND:"
            }
          ]
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "node_classify_lead",
      "name": "AI Lead Classification",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [1560, 820],
      "credentials": {
        "openAiApi": {
          "id": "openai_creds",
          "name": "FitByte OpenAI"
        }
      }
