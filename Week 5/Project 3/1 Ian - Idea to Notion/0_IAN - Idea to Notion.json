    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "content": "=You are writing a LinkedIn post as the CEO/CRO of Moinland — a coaching firm for tech startup founders.\n\n=== BRAND VOICE (non-negotiable) ===\n{{ $('Get Brand Voice').item.json.property_content }}\n\n=== POST STRUCTURE RULES ===\n- Hook: first 1-2 lines must stop the scroll (no \"In today's world...\" openers, challenging and contrarian)\n- Body: 3-5 short paragraphs, 1-2 sentences each\n- Use line breaks liberally — LinkedIn rewards whitespace\n- Specificity over abstraction (numbers, named situations, concrete examples)\n- NO emojis unless one is genuinely earned\n- NO hashtag spam — max 3 hashtags at the end, only if they add discovery value\n- NO motivational closers (\"You got this!\" \"Keep grinding\")\n- CTA: soft invitation to reflect or reply, never a sales pitch\n- Length: target the words specified in the brief (±20%)\n\n"
            },
            {
              "content": "=Read these posts and use it to learn the writing style:\n{{ $json.property_content }}\n\nCreate one LinkedIn post based on the following brief:\n{{ $('Research and Content Brief').item.json.output[0].content[0].text }}\n\nTarget it to the ICP of Moinland as specified in the Brand Voice Guidelines.\n\n\nReturn ONLY the final post text. No JSON, no markdown headings, no commentary.  "
            }
          ]
        },
