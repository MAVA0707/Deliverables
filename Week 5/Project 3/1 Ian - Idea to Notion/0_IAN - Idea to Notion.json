        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are a senior LinkedIn content strategist for Moinland. Your job is to produce a structured content BRIEF (not the post itself) that a writer will use to draft a LinkedIn post.\n\nThink step by step. For the topic provided, work through:\n1. What is the single \"aha\" insight this post must deliver?\n2. Who exactly is the reader, and what state of mind are they in when they scroll past?\n3. What hook style will stop them (contrarian claim, surprising stat, vivid story, sharp question)?\n4. What is the supporting evidence or story beat?\n5. What is the one specific takeaway action or mindset shift?\n6. What is the CTA (soft — invitation to think, comment, or DM — NEVER \"book a call\")?\n"
            },
            {
              "content": "=Create a content brief for the following topic:  {{ $('Telegram Listener').item.json.message.text }}\n\nSearch the web and find 2-5 data points, that resonate ffor the target ICP."
            }
          ]
        },
        "builtInTools": {
          "webSearch": {
            "searchContextSize": "medium"
          }
        },
        "options": {}
      },
