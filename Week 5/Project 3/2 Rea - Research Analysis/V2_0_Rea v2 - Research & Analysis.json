    {
      "parameters": {
        "jsCode": "// Filter out failed RSS items and log which feeds broke.\n// If ALL feeds failed, throw so the error workflow fires.\nconst results = [];\nconst failed = [];\n\nfor (const item of $input.all()) {\n  if (item.json.error) {\n    failed.push({\n      feed: item.json.url || 'unknown',\n      error: item.json.error.message || String(item.json.error)\n    });\n    continue;\n  }\n  if (!item.json.title || !item.json.link) continue;\n  results.push(item);\n}\n\nif (failed.length > 0) {\n  console.log('[Rea] Failed RSS feeds:', JSON.stringify(failed));\n}\n\nif (results.length === 0) {\n  throw new Error('All RSS feeds failed or returned no usable items. Feeds attempted: ' + JSON.stringify(failed));\n}\n\nreturn results;"
      },
