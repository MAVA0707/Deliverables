    {
      "parameters": {
        "jsCode": "// Guard: if AI output is missing or too short, substitute a clear fallback\n// so Markus never receives a blank or broken email.\nconst output = $input.first()?.json?.output ?? '';\n\nif (!output || output.trim().length < 50) {\n  return [{\n    json: {\n      output: '**Rea Briefing — ' + new Date().toLocaleDateString('de-DE') + '**\\n\\n' +\n              'The AI agent could not generate a briefing this week.\\n\\n' +\n              'This is usually caused by an empty Pinecone index (no articles ingested this week) ' +\n              'or a transient OpenAI API error.\\n\\n' +\n              'Please check the N8N execution log for details.'\n    }\n  }];\n}\n\nreturn $input.all();"
      },
